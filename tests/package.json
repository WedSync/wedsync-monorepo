{
  "name": "@wedsync/tests",
  "version": "1.0.0",
  "private": true,
  "description": "Test suite for WedSync platform",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:contract": "jest tests/contract",
    "test:integration": "jest tests/integration",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "jest-environment-node": "^29.5.0",
    "supertest": "^6.3.0",
    "@types/supertest": "^2.0.0",
    "nock": "^13.3.0",
    "@playwright/test": "^1.40.0",
    "typescript": "^5.3.3",
    "ts-jest": "^29.1.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!**/*.d.ts",
      "!**/node_modules/**"
    ],
    "testMatch": [
      "**/tests/**/*.test.ts",
      "**/tests/**/*.spec.ts"
    ],
    "moduleNameMapping": {
      "^@wedsync/(.*)$": "<rootDir>/../packages/$1/src"
    }
  }
}